# Public base URL used for metadata, sitemap, and robots.
# Set this to the production domain before launch, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form delivery is disabled until all three values below are set.
# The form validates enquiries without sending them when these are missing.
# Obtain an API key from the chosen transactional email provider (Resend is used here).
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
