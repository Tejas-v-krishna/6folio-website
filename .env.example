# Public form endpoints. Leave blank to keep the honest "not connected" state.
# Use the public form URL from a provider such as Formspree, Basin, or your own API.
# Never put private API keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Production site URL, used for canonical and social image URLs once deployed.
# Example: https://sixfolio.com
NEXT_PUBLIC_SITE_URL=
